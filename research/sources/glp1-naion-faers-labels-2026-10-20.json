 "viagra_label": {
  "setid": "d905dc8d-917f-4ea3-a4ee-a1ecf6967d4e",
  "version": "6",
  "effective": "20231117",
  "quote_case_crossover": "An observational case-crossover study evaluated the risk of NAION when PDE5 inhibitor use, as a class, occurred immediately before NAION onset (within 5 half-lives), compared to PDE5 inhibitor use in a prior time period. The results suggest an approximate 2-fold increase in the risk of NAION, with a risk estimate of 2.15 (95% CI 1.06, 4.34). A similar study reported a consistent result, with a risk estimate of 2.27 (95% CI 0.99, 5.20).",
  "quote_stop": "Patients should stop VIAGRA and seek medical care if a sudden loss of vision occurs in one or both eyes, which could be a sign of non arteritic anterior ischemic optic neuropathy (NAION)."
 },
